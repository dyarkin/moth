class Moth < Formula
  desc "CLI tool for managing and composing config files"
  homepage "https://github.com/dyarkin/moth"
  version "{{VERSION}}"

  on_macos do
    on_arm do
      url "https://github.com/dyarkin/moth/releases/download/v{{VERSION}}/moth-darwin-arm64.tar.gz"
      sha256 "{{SHA256_DARWIN_ARM64}}"
    end
    on_intel do
      url "https://github.com/dyarkin/moth/releases/download/v{{VERSION}}/moth-darwin-x64.tar.gz"
      sha256 "{{SHA256_DARWIN_X64}}"
    end
  end

  on_linux do
    on_arm do
      url "https://github.com/dyarkin/moth/releases/download/v{{VERSION}}/moth-linux-arm64.tar.gz"
      sha256 "{{SHA256_LINUX_ARM64}}"
    end
    on_intel do
      url "https://github.com/dyarkin/moth/releases/download/v{{VERSION}}/moth-linux-x64.tar.gz"
      sha256 "{{SHA256_LINUX_X64}}"
    end
  end

  def install
    bin.install "moth"
  end

  test do
    assert_match version.to_s, shell_output("#{bin}/moth --version")
  end
end
