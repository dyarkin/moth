{
  "name": "moth",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "version": "0.1.0",
  "devDependencies": {
    "@commitlint/cli": "^21.0.1",
    "@commitlint/config-conventional": "^21.0.1",
    "@types/bun": "latest",
    "@typescript-eslint/eslint-plugin": "^8.59.3",
    "@typescript-eslint/parser": "^8.59.3",
    "eslint": "^10.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.4",
    "prettier": "^3.8.3"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@types/nunjucks": "^3.2.6",
    "chalk": "^5.6.2",
    "commander": "^14.0.3",
    "dev": "^0.1.3",
    "nunjucks": "^3.2.4",
    "yaml": "^2.9.0"
  },
  "lint-staged": {
    "*.ts": [
      "prettier --write",
      "eslint --max-warnings=0"
    ]
  },
  "scripts": {
    "prepare": "husky",
    "test:unit": "bun test",
    "test:unit:watch": "bun test --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "build": "bun run scripts/build.ts",
    "build:release": "bun run scripts/build.ts --release",
    "release": "bun pm version --message \"chore(release): v%s\""
  }
}
